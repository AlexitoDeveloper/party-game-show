{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/spotify-preview/:id",
      "destination": "/api/spotify-preview/[id]"
    },
    {
      "source": "/api/spotify-playlist/:id",
      "destination": "/api/spotify-playlist/[id]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
